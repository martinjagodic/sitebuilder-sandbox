#!/usr/bin/env bash
#
# Sandbox helper. Runs a sitebuilder command inside a project subfolder with
# the core Hugo module pointed at the local checkout, so edits to
# sitebuilder-core show up immediately without publishing a module version.
#
#   ./sb dev greenleaf
#   ./sb build greenleaf
#   ./sb new <name> [--lang en]
#
# Core is expected next to this repo (../sitebuilder-core), which is also where
# each project's `file:../../sitebuilder-core` dependency points. CI clones only
# this repo, so there sb clones core into that same spot first — at
# SITEBUILDER_CORE_REF (default main) — and everything resolves exactly as it
# does locally. On Cloudflare Pages that needs GITHUB_TOKEN and
# SKIP_DEPENDENCY_INSTALL=1, because Pages' own install would run before core
# exists.

set -euo pipefail

SANDBOX="$(cd "$(dirname "$0")" && pwd)"
CORE="${SITEBUILDER_CORE:-$(dirname "$SANDBOX")/sitebuilder-core}"
cd "$SANDBOX"

if [[ ! -d "$CORE" ]]; then
  if [[ -z "${CI:-}" ]]; then
    echo "sb: no sitebuilder-core at ${CORE}. Clone it there or set SITEBUILDER_CORE." >&2
    exit 1
  fi
  : "${GITHUB_TOKEN:?sb: GITHUB_TOKEN is needed to clone the private sitebuilder-core}"
  ref="${SITEBUILDER_CORE_REF:-main}"
  echo "sb: cloning sitebuilder-core@${ref}"
  git clone --quiet --depth 1 --branch "$ref" \
    "https://x-access-token:${GITHUB_TOKEN}@github.com/martinjagodic/sitebuilder-core.git" "$CORE"
fi

export HUGO_MODULE_REPLACEMENTS="github.com/martinjagodic/sitebuilder-core -> ${CORE}"

command="${1:-}"
project="${2:-}"

if [[ -z "$command" ]]; then
  echo "usage: ./sb <dev|build|lint|new> <project>" >&2
  exit 1
fi

if [[ "$command" == "new" ]]; then
  shift 2 || true
  node "${CORE}/bin/sitebuilder.js" new "$project" --local "$@"
  echo "Now run: cd ${project} && pnpm install"
  exit 0
fi

if [[ -z "$project" || ! -d "$project" ]]; then
  echo "sb: no such project '${project}'" >&2
  exit 1
fi

cd "$project"
shift 2 || true

if [[ -n "${CI:-}" ]]; then
  # Core's dependencies can differ between branches, so the lockfile (written
  # against a local checkout) is used when it still fits, not enforced.
  pnpm install --no-frozen-lockfile
fi

exec node "${CORE}/bin/sitebuilder.js" "$command" "$@"
